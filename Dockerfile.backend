# Utilisation de l'image officielle vLLM
FROM vllm/vllm-openai:v0.5.4

# Dossier de travail
WORKDIR /app

# On ne copie que le nécessaire (Modèle fusionné et fichiers de config)
# Assure-toi d'avoir un fichier .dockerignore pour ne pas copier les logs/datasets bruts
COPY ./models/merged_dpo_final_chsa /app/model
COPY . /app

# Variables d'environnement pour Cloud Run
ENV PORT=8080
ENV HOST=0.0.0.0
# On force vLLM à ne pas essayer de se connecter à internet au démarrage (sécurité hospitalière)
ENV HF_HUB_OFFLINE=1 

# Cloud Run injecte la variable $PORT
# --model : chemin vers tes poids finaux
# --gpu-memory-utilization : on baisse à 0.8 pour laisser de la place au système
# --max-model-len : 2048 suffit pour du triage et économise énormément de VRAM
# --enforce-eager : recommandé pour éviter les erreurs de compilation de graphes CUDA en mode POC
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]

# Nouveau CMD optimisé pour la latence pure
CMD [ \
    "--model", "/app/model", \
    "--host", "0.0.0.0", \
    "--port", "8080", \
    "--max-model-len", "2048", \
    "--max-num-batched-tokens", "1024", \
    "--enforce-eager", \
    "--gpu-memory-utilization", "0.8", \
    "--disable-log-stats", \
    "--disable-log-requests" \
]