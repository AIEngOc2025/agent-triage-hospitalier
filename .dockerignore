__pycache__/
*.pyc
*.pyo
*.egg-info

# --- Fichiers de configuration d'IDE et système ---
.vscode/
.idea/
.DS_Store

# --- Logs et rapports ---
*.log
logs/

# --- Git ---
.git/
.gitignore