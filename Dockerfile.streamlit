FROM python:3.12-slim
WORKDIR /app

# Installer uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN chmod +x /usr/local/bin/uv

# Copier les fichiers de configuration
COPY pyproject.toml uv.lock ./

# Synchroniser les dépendances (y compris streamlit)
RUN uv sync --no-dev --no-editable

# Copier le code UI
COPY ui_agent_streamlit.py .

# Utiliser l'environnement virtuel créé par uv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8080

CMD ["python", "-m", "streamlit", "run", "ui_agent_streamlit.py", "--server.port=8080", "--server.address=0.0.0.0"]
