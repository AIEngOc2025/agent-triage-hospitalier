# Dockerfile pour environnement local macOS (test de compatibilité)
# NOTE : Docker sur macOS tourne dans une machine virtuelle Linux.
# MLX-ML nécessite un accès matériel natif Apple Silicon (Metal).
# Cette image NE BÉNÉFICIERA PAS de l'accélération GPU/Metal.
# Pour la performance, utilisez `uv run` nativement sur macOS.

FROM python:3.11-slim

WORKDIR /app
ENV APP_ENV=development
ENV PYTHONUNBUFFERED=1

# Installation des outils de build et dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copier les dépendances et installer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier le code
COPY . .

# Exposer le port de l'application
EXPOSE 7860

# Démarrage
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
