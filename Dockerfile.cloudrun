# --- 1. Image de base ---
# Utilisation de l'image officielle vLLM qui contient déjà CUDA, PyTorch, et vLLM.
FROM vllm/vllm-openai:latest

# --- 2. Configuration de l'environnement ---
WORKDIR /app
ENV APP_ENV=production
ENV PYTHONUNBUFFERED=1
# La variable PORT sera fournie par Cloud Run au démarrage.
# Nous n'avons plus besoin de GRADIO_SERVER_PORT.

# --- 3. Installation des dépendances manquantes ---
# Nous installons uniquement les dépendances nécessaires à notre application
# qui ne sont pas déjà incluses dans l'image de base vLLM.
RUN pip install --no-cache-dir \
    gradio \
    pydantic-settings \
    uv \
    python-dotenv

# --- 4. Copie du code de l'application ---
# Copier le reste du code de l'application.
COPY ./app/ /app
COPY ./models/ /app/models

# --- 5. Exposition du port ---
# Cloud Run s'attend à ce que le conteneur écoute sur le port défini par la variable PORT,
# qui est 8080 par défaut.
EXPOSE 8080

# --- 6. Commande de démarrage pour Cloud Run ---
# Lancer l'application en utilisant le port fourni par l'environnement ($PORT).
# Uvicorn est idéal pour un environnement de production comme Cloud Run.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]