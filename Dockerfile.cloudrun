# Utilisation de l'image de base qui contient déjà python et les outils nécessaires
FROM python:3.12-slim

# Définir le répertoire de travail
WORKDIR /app

# Installation de curl et git
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copier les fichiers de dépendances
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Installation de gsutil (via pip pour éviter les problèmes de dépôts apt)
RUN pip install --no-cache-dir gsutil

# --- ÉTAPE CRUCIALE : Téléchargement des modèles ---
RUN mkdir -p /app/models
# Téléchargement des modèles depuis GCS
RUN gsutil -m cp -r gs://modeles-triage-hospitalier/merged_dpo_final_chsa /app/models/

# Copier le code de l'application
COPY ./app /app/app
COPY ./models /app/models

# Exposition du port
EXPOSE 8080

# Commande de lancement
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
