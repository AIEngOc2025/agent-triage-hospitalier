# Utilisation de l'image de base qui contient déjà python et les outils nécessaires
FROM python:3.12-slim

# Définir le répertoire de travail
WORKDIR /app

# Installation de gsutil (pour récupérer les modèles) et docker (si besoin de manipuler)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    google-cloud-sdk \
    && rm -rf /var/lib/apt/lists/*

# Copier les fichiers de dépendances
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- ÉTAPE CRUCIALE : Téléchargement des modèles ---
# On suppose que gsutil est configuré ou que le service account a les droits
RUN mkdir -p /app/models
# Téléchargement des modèles depuis GCS
RUN gsutil -m cp -r gs://modeles-triage-hospitalier/merged_dpo_final_chsa /app/models/

# Copier le code de l'application
COPY ./app /app/app
COPY ./models /app/models

# Exposition du port
EXPOSE 8080

# Commande de lancement
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
