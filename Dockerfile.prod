# 1. Utiliser l'image officielle PyTorch avec CUDA (indispensable pour l'usage du GPU L4)
FROM pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# Définir le répertoire de travail
WORKDIR /app

# 2. Installer les dépendances système requises pour vLLM
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# 3. Mettre à jour pip et installer explicitement les bonnes versions
RUN pip install --no-cache-dir --upgrade pip

# Installer d'abord transformers et les outils de formatage pour éviter les conflits
RUN pip install --no-cache-dir "transformers>=4.40.0,<5.0.0" "lm-format-enforcer"




# Installer vLLM (compatible avec CUDA 12.1)
RUN pip install --no-cache-dir vllm==0.4.2

# 4. Copier votre code applicatif si vous avez des scripts personnalisés
COPY . .

# 5. Définir les variables d'environnement pour s'assurer que vLLM utilise le port de Cloud Run
ENV PORT=8080
ENV HOST=0.0.0.0

# 6. Commande de démarrage par défaut pour vLLM en mode serveur compatible OpenAI
# Note : Nous passons le modèle via la variable d'environnement ou directement en argument
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
CMD ["--model", "gs://modeles-triage-hospitalier/merged_dpo_final_chsa", "--port", "8080"]
