# --- ÉTAPE 1: Base de Production ---
# Utilisation de l'image officielle vllm-openai. Elle contient déjà :
# - vllm, torch, transformers
# - CUDA (pour les GPU)
# - gcsfs pour télécharger les modèles depuis GCS (`gs://`)
FROM vllm/vllm-openai:v0.5.1

# Définir le répertoire de travail principal pour toutes les opérations suivantes
WORKDIR /app

# --- ÉTAPE 2: Copie du projet et installation des dépendances ---
# Copier tout le contexte de build (sauf les fichiers dans .dockerignore)
COPY . .


# Installer uv, puis les dépendances de production.
# On force l'installation de torch et transformers pour garantir leur présence
# avant d'installer les dépendances du projet.
RUN pip install uv
RUN uv pip install --system "torch>=2.4.0" "transformers[torch]==5.14.1"
RUN uv pip install --system -r requirements-linux.txt

# Installer le modèle de langue pour Spacy (utilisé par Presidio)
RUN python3 -m spacy download fr_core_news_sm

# --- ÉTAPE 4: Point d'entrée ---
# Rendre le script de démarrage exécutable et le définir comme commande de lancement.
RUN chmod +x start_light_prod.sh
EXPOSE 8080
ENTRYPOINT []
CMD ["./start_light_prod.sh"]
